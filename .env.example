# FREEFLO — variables d'environnement (phase 2)
#
# Copier ce fichier en `.env.local` et y coller les valeurs du projet Supabase :
# tableau de bord → Settings → API. `.env.local` est ignoré par git, ce fichier-ci
# ne doit JAMAIS contenir de vraie clé.

# Project URL, de la forme https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clé « anon public ». Elle part dans le navigateur, c'est prévu : la sécurité
# repose sur les règles RLS de Postgres, pas sur le secret de cette clé.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé « service_role ». Elle CONTOURNE toutes les règles RLS : jamais dans un
# composant client, jamais préfixée NEXT_PUBLIC_, jamais committée. Uniquement
# côté serveur (Server Actions, routes d'API, tâches planifiées).
SUPABASE_SERVICE_ROLE_KEY=
